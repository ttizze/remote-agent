@@ -0,0 +1,28 @@
+#[cfg(target_arch = "x86_64")]
+#[test]
+fn a01_horizontal_add_and_scalar_store() {
+    use core::arch::x86_64::*;
+    if !std::is_x86_feature_detected!("sse3") { return; }
+    unsafe {
+        let a = _mm_set_ps(8.0, 4.0, 2.0, 1.0);
+        let b = _mm_set_ps(-8.0, -4.0, -2.0, -1.0);
+        let lanes: [f32; 4] = core::mem::transmute(_mm_hadd_ps(a, b));
+        assert_eq!(lanes, [3.0, 12.0, -3.0, -12.0]);
+        let mut output = [91.0, 92.0, 93.0];
+        _mm_store_ss(output.as_mut_ptr().add(1), a);
+        assert_eq!(output, [91.0, 1.0, 93.0]);
+        println!("| hadd {lanes:?}; scalar store {output:?}");
+    }
+}
+
+#[cfg(target_arch = "x86_64")]
+#[test]
+fn a02_broadcasts_all_sixteen_signed_lanes() {
+    use core::arch::x86_64::*;
+    if !std::is_x86_feature_detected!("avx512f") { return; }
+    for value in [i32::MIN, -1, 0, 17, i32::MAX] {
+        let lanes: [i32; 16] = unsafe { core::mem::transmute(_mm512_set1_epi32(value)) };
+        assert_eq!(lanes, [value; 16]);
+        println!("| broadcast {value}: {lanes:?}");
+    }
+}
diff --git a/libs/relax/compiler/tests/std/core_constructor_temp_lifetime.rs b/libs/relax/compiler/tests/std/core_constructor_temp_lifetime.rs
