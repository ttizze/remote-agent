index 0000000..597142e
--- /dev/null
+++ b/libs/relax/compiler/tests/std/core_constructor_temp_lifetime.rs
@@ -0,0 +1,42 @@
+use std::cell::Cell;
+use std::rc::Rc;
+
+struct Probe(Rc<Cell<usize>>, String);
+impl Drop for Probe {
+    fn drop(&mut self) { self.0.set(self.0.get() + 1); }
+}
+struct Borrowed<'a>(&'a Probe);
+
+#[test]
+fn a01_variant_constructor_keeps_the_borrowed_temporary_alive() {
+    let drops = Rc::new(Cell::new(0));
+    {
+        let value = Some(&Probe(drops.clone(), "variant".into()));
+        assert_eq!(drops.get(), 0);
+        assert_eq!(value.unwrap().1, "variant");
+    }
+    assert_eq!(drops.get(), 1);
+    println!("| variant temporary drops at the end of its binding's scope");
+}
+
+#[test]
+fn a02_tuple_struct_keeps_the_borrowed_temporary_alive() {
+    let drops = Rc::new(Cell::new(0));
+    {
+        let value = Borrowed(&Probe(drops.clone(), "tuple".into()));
+        assert_eq!(drops.get(), 0);
+        assert_eq!(value.0.1, "tuple");
+    }
+    assert_eq!(drops.get(), 1);
+    println!("| tuple struct temporary drops at the end of its binding's scope");
+}
+
+#[test]
+fn a03_ordinary_calls_do_not_extend_their_arguments() {
+    fn consume(value: Borrowed<'_>) -> usize { value.0.0.get() }
+    let drops = Rc::new(Cell::new(0));
+    let during_call = consume(Borrowed(&Probe(drops.clone(), "call".into())));
+    assert_eq!(during_call, 0);
+    assert_eq!(drops.get(), 1);
+    println!("| ordinary call's argument drops at the end of the statement");
+}
diff --git a/libs/relax/compiler/tests/std/core_net_identity.rs b/libs/relax/compiler/tests/std/core_net_identity.rs
new file mode 100644
index 0000000..0fc7320
--- /dev/null
+++ b/libs/relax/compiler/tests/std/core_net_identity.rs
@@ -0,0 +1,37 @@
+// core::net and std::net must expose the same types, including FromStr and errors.
+use core::net::{AddrParseError, IpAddr, Ipv4Addr, Ipv6Addr, SocketAddr, SocketAddrV4, SocketAddrV6};
+use std::net::ToSocketAddrs;
+
+#[test]
+fn a01_addresses_keep_their_identity_across_core_and_std() {
+    let ip: std::net::IpAddr = IpAddr::V4(Ipv4Addr::LOCALHOST);
+    let v4: std::net::SocketAddrV4 = SocketAddrV4::new(Ipv4Addr::LOCALHOST, 8080);
+    let mut v6: std::net::SocketAddrV6 = SocketAddrV6::new(Ipv6Addr::LOCALHOST, 9090, 7, 3);
+    let socket: std::net::SocketAddr = SocketAddr::from(v4);
+    assert_eq!(socket.ip(), ip);
+    assert_eq!(socket.to_socket_addrs().unwrap().collect::<Vec<_>>(), vec![socket]);
+    assert_eq!(v6.flowinfo(), 7);
+    assert_eq!(v6.scope_id(), 3);
+    v6.set_flowinfo(u32::MAX);
+    v6.set_scope_id(u32::MAX);
+    assert_eq!(v6.flowinfo(), u32::MAX);
+    assert_eq!(v6.scope_id(), u32::MAX);
+    v6.set_flowinfo(0);
+    v6.set_scope_id(0);
+    assert_eq!(v6.flowinfo(), 0);
+    assert_eq!(v6.scope_id(), 0);
+    assert_eq!(v6.ip(), &Ipv6Addr::LOCALHOST);
+    assert_eq!(v6.port(), 9090);
+    assert_eq!("[::1%3]:9090".parse::<SocketAddr>().unwrap().to_string(), "[::1%3]:9090");
+    assert_eq!("127.0.0.1:8080".parse::<SocketAddr>().unwrap(), socket);
+    let error: AddrParseError = "256.0.0.1".parse::<Ipv4Addr>().unwrap_err();
+    let _: std::net::AddrParseError = error;
+    assert!(Ipv4Addr::LOCALHOST == ip);
+    assert!(ip == Ipv4Addr::LOCALHOST);
+    assert!(!(Ipv6Addr::LOCALHOST == ip));
+    let ip6 = IpAddr::V6(Ipv6Addr::LOCALHOST);
+    assert!(Ipv6Addr::LOCALHOST == ip6);
+    assert!(ip6 == Ipv6Addr::LOCALHOST);
+    assert!(!(Ipv4Addr::LOCALHOST == ip6));
+    println!("| core and std share address types, parsing, and socket resolution");
+}
