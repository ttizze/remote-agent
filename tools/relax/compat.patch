+// Associated str UTF-8 constructors: const use, validation, and mutable views.
+const CHECKED: &str = match str::from_utf8(b"\xc3\xa9") { Ok(s) => s, Err(_) => panic!("valid UTF-8") };
+const UNCHECKED: &str = unsafe { str::from_utf8_unchecked(b"hello") };
+
+#[test]
+fn a01_associated_constructors_validate_and_work_in_constants() {
+    assert_eq!(CHECKED, "é");
+    assert_eq!(UNCHECKED, "hello");
+    assert!(str::from_utf8(&std::hint::black_box([0xff])).is_err());
+    println!("| associated UTF-8 constructors preserve validation and constants");
+}
+
+#[test]
+fn a02_mutable_constructors_borrow_the_original_bytes() {
+    let mut bytes = *b"ab";
+    str::from_utf8_mut(&mut bytes).unwrap().make_ascii_uppercase();
+    assert_eq!(bytes, *b"AB");
+    unsafe { str::from_utf8_unchecked_mut(&mut bytes) }.make_ascii_lowercase();
+    assert_eq!(bytes, *b"ab");
+    assert!(str::from_utf8_mut(&mut std::hint::black_box([0xff])).is_err());
+    println!("| associated mutable UTF-8 constructors update their input");
+}
