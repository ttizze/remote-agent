+// Used by agent-core; compare with rustc through core_diff.sh.
+#[test]
+fn a01_maps_once_and_defaults_without_calling_the_closure() {
+    let calls = std::cell::Cell::new(0);
+    let value = Some(7).map_or_default(|n| {
+        calls.set(calls.get() + 1);
+        n * 3
+    });
+    assert_eq!((value, calls.get()), (21, 1));
+    let empty: Option<u32> = None;
+    let default: String = empty.map_or_default(|_| panic!("None must not map"));
+    assert!(default.is_empty());
+    let owned = String::from("owned");
+    assert_eq!(Some(()).map_or_default(move |_| owned), "owned");
+    println!("| map_or_default maps once, consumes captures, and defaults lazily");
+}
