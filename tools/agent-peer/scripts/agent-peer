#!/usr/bin/env python3
"""Ask Claude Code or Codex and resume their native conversations."""
import argparse
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import uuid


def command(provider, binary, session_id, model):
    if provider == "claude":
        argv = [binary, "-p", "--output-format", "json",
                "--tools", "Read,Glob,Grep", "--allowedTools", "Read,Glob,Grep",
                "--permission-mode", "dontAsk", "--disable-slash-commands",
                "--strict-mcp-config", "--mcp-config", '{"mcpServers":{}}',
                "--settings", '{"disableAllHooks":true}']
        if session_id:
            argv += ["--resume", session_id]
    else:
        argv = [binary, "exec", "--json", "--sandbox", "read-only",
                "--skip-git-repo-check", "-c", 'approval_policy="never"']
        if session_id:
            argv += ["resume", session_id]
    if model:
        argv += ["--model", model]
    if provider == "codex":
        argv.append("-")
    return argv


def decode(provider, output, returncode):
    """Return only the completed reply, never a progress message as success."""
    if provider == "claude":
        result = json.loads(output)
        if not isinstance(result, dict) or result.get("type") != "result":
            raise ValueError("Claude did not return a final result")
        denied = result.get("permission_denials", [])
        failed = returncode != 0 or result.get("is_error", False)
        status = "error" if failed else "blocked" if denied else "ok"
        return dict(session_id=result.get("session_id"), status=status,
                    text=result.get("result", ""),
                    errors=result.get("errors", []),
                    denied_tools=[item.get("tool_name") for item in denied])
    events = [json.loads(line) for line in output.splitlines() if line.strip()]
    session_id = next((e.get("thread_id") for e in events
                       if e.get("type") == "thread.started"), None)
    messages = [e["item"].get("text", "") for e in events
                if e.get("type") == "item.completed"
                and e.get("item", {}).get("type") == "agent_message"]
    errors = [e.get("error", {}).get("message", "Codex turn failed")
              for e in events if e.get("type") == "turn.failed"]
    complete = any(e.get("type") == "turn.completed" for e in events)
    failed = returncode != 0 or bool(errors) or not complete
    if not complete and not errors:
        errors = [e.get("message", "Codex error") for e in events
                  if e.get("type") == "error"] or ["No completed turn received"]
    return dict(session_id=session_id, status="error" if failed else "ok",
                text="\n\n".join(messages), errors=errors, denied_tools=[])


def invoke(argv, cwd, prompt, timeout):
    with subprocess.Popen(argv, cwd=cwd, stdin=subprocess.PIPE,
                          stdout=subprocess.PIPE, text=True,
                          start_new_session=True) as process:
        try:
            output, _ = process.communicate(prompt, timeout=timeout)
        except (subprocess.TimeoutExpired, KeyboardInterrupt):
            os.killpg(process.pid, signal.SIGTERM)
            try:
                process.communicate(timeout=5)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGKILL)
                process.communicate()
            raise
        return output, process.returncode


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="action", required=True)
    for action in ("ask", "reply"):
        p = sub.add_parser(action)
        p.add_argument("provider", choices=("claude", "codex"))
        if action == "reply":
            p.add_argument("session_id", type=lambda s: str(uuid.UUID(s)))
        p.add_argument("prompt", help="text, or - for stdin")
        p.add_argument("--cwd", required=True, type=Path, help="target project directory")
        p.add_argument("--model", help="native model name; otherwise use CLI/session default")
        p.add_argument("--timeout", type=float, default=600, help="seconds (default: 600)")
    args = parser.parse_args()
    session_id = getattr(args, "session_id", None)
    envelope = dict(provider=args.provider, session_id=session_id,
                    cwd=str(args.cwd.expanduser().resolve()))
    try:
        if args.timeout <= 0:
            raise ValueError("--timeout must be positive")
        if not Path(envelope["cwd"]).is_dir():
            raise ValueError("--cwd must be an existing directory")
        if args.prompt == "-" and sys.stdin.isatty():
            raise ValueError("Pass a prompt argument or pipe the prompt through stdin")
        prompt = sys.stdin.read() if args.prompt == "-" else args.prompt
        if not prompt.strip():
            raise ValueError("Prompt must not be empty")
        binary = os.environ.get("AGENT_PEER_" + args.provider.upper() + "_BIN")
        if not binary:
            candidates = []
            if args.provider == "codex":
                candidates += [Path("/Applications/ChatGPT.app/Contents/Resources/codex"),
                               Path("/Applications/Codex.app/Contents/Resources/codex")]
            on_path = shutil.which(args.provider)
            if on_path:
                candidates.append(Path(on_path))
            candidates.append(Path.home() / ".local" / "bin" / args.provider)
            binary = next((str(p) for p in candidates
                           if p.is_file() and os.access(p, os.X_OK)), None)
        if not binary:
            raise ValueError("CLI not found: " + args.provider)
        argv = command(args.provider, binary, session_id, args.model)
        output, returncode = invoke(argv, envelope["cwd"], prompt, args.timeout)
        result = decode(args.provider, output, returncode)
        returned_id = result.get("session_id")
        if returned_id:
            uuid.UUID(returned_id)
        if session_id and returned_id and returned_id != session_id:
            raise ValueError("Provider returned a different conversation ID")
        result["session_id"] = returned_id or session_id
        if result["status"] == "ok" and not result["session_id"]:
            raise ValueError("Provider returned no conversation ID")
        envelope.update(result)
    except subprocess.TimeoutExpired:
        envelope.update(status="error", text="", errors=[
            "Timed out; the provider may have saved a partial turn. No automatic retry."])
    except KeyboardInterrupt:
        envelope.update(status="error", text="", errors=["Interrupted; no automatic retry."])
    except (OSError, ValueError, TypeError, KeyError) as exc:
        envelope.update(status="error", text="", errors=[str(exc)])
    print(json.dumps(envelope, ensure_ascii=False))
    return 0 if envelope["status"] == "ok" else 1


if __name__ == "__main__":
    def interrupted(signum, frame):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, interrupted)
    sys.exit(main())
