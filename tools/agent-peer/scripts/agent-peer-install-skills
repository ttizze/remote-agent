#!/usr/bin/env python3
"""Link the packaged skill into the selected Codex and Claude homes."""
import argparse
import os
from pathlib import Path
import sys
import tempfile


def install(source, destinations):
    if not (source / "SKILL.md").is_file():
        raise ValueError("The package has no SKILL.md")
    for destination in destinations:
        if destination.exists() and not destination.is_symlink():
            raise ValueError(f"Refusing to replace non-symlink: {destination}")
    for destination in destinations:
        destination.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(prefix=".agent-peer-", dir=destination.parent) as staging:
            link = Path(staging) / "skill"
            link.symlink_to(source, target_is_directory=True)
            link.replace(destination)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--codex-home", type=Path,
                        default=Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex"))
    parser.add_argument("--claude-home", type=Path,
                        default=Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude"))
    args = parser.parse_args()
    source = Path(__file__).resolve().parents[1]
    destinations = [home.expanduser().absolute() / "skills" / "agent-peer"
                    for home in (args.codex_home, args.claude_home)]
    try:
        install(source, destinations)
    except (OSError, ValueError) as exc:
        print(str(exc), file=sys.stderr)
        return 1
    for destination in destinations:
        print(f"{destination} -> {source}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
