+    ///
+    /// Each Cargo keeps a shared lock on the units it has finished. Waiting
+    /// for the exclusive lock alone deadlocks two Cargos that each finished a
+    /// unit the other still wants.
+    #[instrument(skip(self, built))]
+    pub fn lock_unless_built(&self, key: &LockKey, built: impl Fn() -> bool) -> CargoResult<()> {
