+/// Invalidates an output only immediately before rebuilding it. With unit
+/// locking this work must run after taking the exclusive lock, and must be
+/// skipped when another Cargo has already built the same inputs. Preparing a
+/// queued job may only hold a shared lock: clearing the fingerprint then makes
+/// active readers look incomplete and prevents other readers from reusing them.
+pub fn invalidate(build_runner: &BuildRunner<'_, '_>, unit: &Unit) -> Work {
+    let loc = build_runner.files().fingerprint_file_path(unit, "");
+    Work::new(move |_| {
+        if loc.exists() {
+            // A failed or interrupted compiler must not leave a valid completion
+            // record for a partially written output. Preserve the JSON diagnosis.
+            paths::write(&loc, b"")?;
+        }
+        Ok(())
+    })
 }

