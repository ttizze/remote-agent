+fn lock_exclusive_unless_built(file: &File, built: impl Fn() -> bool) -> CargoResult<()> {
+    loop {
+        match flock::try_lock_exclusive(file) {
+            Ok(()) => return Ok(()),
+            Err(TryLockError::WouldBlock) => {}
+            Err(TryLockError::Error(e)) => return Err(e.into()),
+        }
+        // A shared lock excludes writers, so a finished fingerprint stays valid.
+        match flock::try_lock_shared(file) {
+            Ok(()) if built() => return Ok(()),
+            Ok(()) => flock::unlock(file)?,
+            Err(TryLockError::WouldBlock) => {}
+            Err(TryLockError::Error(e)) => return Err(e.into()),
+        }
+        thread::sleep(Duration::from_millis(100));
+    }
+}
