+#[cfg(test)]
+mod fork_defaults {
+    use super::*;
+    use std::sync::Arc;
+    use std::sync::atomic::{AtomicBool, Ordering};
+    use std::time::Instant;
+
+    fn unit_lock(dir: &tempfile::TempDir, name: &str) -> File {
+        std::fs::OpenOptions::new()
+            .create(true)
+            .truncate(false)
+            .read(true)
+            .write(true)
+            .open(dir.path().join(name))
+            .unwrap()
+    }
+
+    fn assert_finishes<T>(waiters: &[thread::JoinHandle<T>]) {
+        let start = Instant::now();
+        while !waiters.iter().all(|waiter| waiter.is_finished()) {
+            assert!(start.elapsed().as_secs() < 30, "cargos deadlocked");
+            thread::sleep(Duration::from_millis(20));
+        }
+    }
+
+    #[test]
+    fn takes_the_exclusive_lock_of_an_unheld_unit() {
+        let dir = tempfile::tempdir().unwrap();
+        let (ours, probe) = (unit_lock(&dir, "a"), unit_lock(&dir, "a"));
+        lock_exclusive_unless_built(&ours, || panic!("nothing holds the unit")).unwrap();
+        assert!(matches!(
+            flock::try_lock_shared(&probe),
+            Err(TryLockError::WouldBlock)
+        ));
+    }
+
+    #[test]
+    fn reuses_a_built_unit_under_a_shared_lock() {
+        let dir = tempfile::tempdir().unwrap();
+        let (ours, theirs, writer) = (
+            unit_lock(&dir, "a"),
+            unit_lock(&dir, "a"),
+            unit_lock(&dir, "a"),
+        );
+        flock::lock_shared(&theirs).unwrap();
+        let waiter = thread::spawn(move || {
+            lock_exclusive_unless_built(&ours, || true).unwrap();
+            ours
+        });
+        assert_finishes(std::slice::from_ref(&waiter));
+        let _ours = waiter.join().unwrap();
+        flock::unlock(&theirs).unwrap();
+        // Ours is what still keeps a writer out.
+        assert!(matches!(
+            flock::try_lock_exclusive(&writer),
+            Err(TryLockError::WouldBlock)
+        ));
+    }
+
+    #[test]
+    fn waits_for_the_holder_of_an_unbuilt_unit() {
+        let dir = tempfile::tempdir().unwrap();
+        let (ours, theirs) = (unit_lock(&dir, "a"), unit_lock(&dir, "a"));
+        flock::lock_shared(&theirs).unwrap();
+        let released = Arc::new(AtomicBool::new(false));
+        let waiter = {
+            let released = released.clone();
+            thread::spawn(move || {
+                lock_exclusive_unless_built(&ours, || false).unwrap();
+                assert!(released.load(Ordering::SeqCst));
+                ours
+            })
+        };
+        thread::sleep(Duration::from_millis(300));
+        released.store(true, Ordering::SeqCst);
+        flock::unlock(&theirs).unwrap();
+        let _ours = waiter.join().unwrap();
+        assert!(matches!(
+            flock::try_lock_shared(&theirs),
+            Err(TryLockError::WouldBlock)
+        ));
+    }
+
+    #[test]
+    fn cargos_that_built_what_the_other_wants_do_not_deadlock() {
+        let dir = tempfile::tempdir().unwrap();
+        let waiters = [("a", "b"), ("b", "a")].map(|(held, wanted)| {
+            let (held, wanted) = (unit_lock(&dir, held), unit_lock(&dir, wanted));
+            flock::lock_shared(&held).unwrap();
+            thread::spawn(move || {
+                lock_exclusive_unless_built(&wanted, || true).unwrap();
+                (held, wanted)
+            })
+        });
+        assert_finishes(&waiters);
+    }
+}
