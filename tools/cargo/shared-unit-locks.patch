+/// A queued rebuild must not invalidate a dependency still used by readers.
+/// Otherwise later readers also queue a write and can deadlock other builds.
+#[cargo_test]
+fn queued_rebuild_keeps_shared_readers_running() {
+    let bar = git::new("bar", |p| {
+        p.file("Cargo.toml", &basic_lib_manifest("bar")).file(
+            "src/lib.rs",
+            "pub const VALUE: &str = env!(\"CACHE_TEST_VALUE\");",
+        )
+    });
+    let manifest = format!(
+        "{}\n[dependencies]\nbar = {{ git = '{}' }}\n[build-dependencies]\nbar = {{ git = '{}' }}\n",
+        basic_manifest("foo", "0.1.0"),
+        bar.url(),
+        bar.url(),
+    );
+    let make_project = |name| {
+        project()
+            .at(name)
+            .file("Cargo.toml", &manifest)
+            .file("src/main.rs", "fn main() { println!(\"{}\", bar::VALUE); }")
+            .file(
+                "build.rs",
+                r#"
+                fn main() {
+                    let _ = bar::VALUE;
+                    if let Some(dir) = std::env::var_os("CACHE_TEST_BARRIER") {
+                        let dir = std::path::PathBuf::from(dir);
+                        std::fs::write(dir.join("ready"), "").unwrap();
+                        let start = std::time::Instant::now();
+                        while !dir.join("release").exists() {
+                            assert!(start.elapsed().as_secs() < 60, "barrier timed out");
+                            std::thread::sleep(std::time::Duration::from_millis(10));
+                        }
+                    }
+                }
+            "#,
+            )
+            .build()
+    };
+    let first_project = make_project("first");
+    let second_project = make_project("second");
+    let third_project = make_project("third");
+    let barrier = paths::root().join("barrier");
+    fs::create_dir(&barrier).unwrap();
+    let mut first = Build::spawn(
+        fork_cargo(&first_project, "build -j1")
+            .env("CACHE_TEST_VALUE", "one")
+            .env("CACHE_TEST_BARRIER", &barrier)
+            .build_command(),
+        "reader",
+    );
+    cargo_test_support::retry(600, || {
+        assert!(first.child.as_mut().unwrap().try_wait().unwrap().is_none());
+        barrier.join("ready").exists().then_some(())
+    });
+    let fingerprints =
+        fs::read_dir(paths::cargo_home().join("targets/shared-deps/debug/build/bar"))
+            .unwrap()
+            .map(|e| e.unwrap().path().join("fingerprint/lib-bar"))
+            .filter(|p| p.is_file())
+            .collect::<Vec<_>>();
+    assert_eq!(fingerprints.len(), 1);
+    let fingerprint = &fingerprints[0];
+    let completed = fs::read(fingerprint).unwrap();
+    assert!(!completed.is_empty());
+    let mut second = Build::spawn(
+        fork_cargo(&second_project, "build -vv -j1")
+            .env("CACHE_TEST_VALUE", "two")
+            .build_command(),
+        "writer",
+    );
+    cargo_test_support::retry(600, || {
+        assert!(
+            second.child.as_mut().unwrap().try_wait().unwrap().is_none(),
+            "{}",
+            fs::read_to_string(&second.stderr).unwrap()
+        );
+        fs::read_to_string(&second.stderr)
+            .unwrap()
+            .contains("Dirty bar ")
+            .then_some(())
+    });
+    assert_eq!(
+        fs::read(fingerprint).unwrap(),
+        completed,
+        "queued writer erased an active reader's completion record"
+    );
+    // Same inputs reuse the completed unit and finish while the first reader
+    // is still alive and the incompatible writer is queued.
+    fork_cargo(&third_project, "build -j1")
+        .env("CACHE_TEST_VALUE", "one")
+        .run();
+    assert!(first.child.as_mut().unwrap().try_wait().unwrap().is_none());
+    assert!(
+        second.child.as_mut().unwrap().try_wait().unwrap().is_none(),
+        "{}",
+        fs::read_to_string(&second.stderr).unwrap()
+    );
+    fs::write(barrier.join("release"), "").unwrap();
+    cargo_test_support::execs().run_output(&first.wait());
+    cargo_test_support::execs().run_output(&second.wait());
+    assert!(!fs::read(fingerprint).unwrap().is_empty());
+    // A failed rebuild still invalidates its completion record; the next
+    // build must rebuild instead of trusting potentially incomplete outputs.
+    fork_cargo(&second_project, "build -j1")
+        .env_remove("CACHE_TEST_VALUE")
+        .with_status(101)
+        .with_stderr_contains(
+            "[ERROR] environment variable `CACHE_TEST_VALUE` not defined at compile time",
+        )
+        .run();
+    assert!(fs::read(fingerprint).unwrap().is_empty());
+    fork_cargo(&second_project, "run -j1")
+        .env("CACHE_TEST_VALUE", "one")
+        .with_stdout_data("one\n")
+        .run();
+    // A matching hash must not hide a missing output either.
+    let out = fingerprint.parent().unwrap().parent().unwrap().join("out");
+    let library = fs::read_dir(out)
+        .unwrap()
+        .map(|e| e.unwrap().path())
+        .find(|p| p.extension().is_some_and(|ext| ext == "rlib"))
+        .unwrap();
+    fs::remove_file(&library).unwrap();
+    fork_cargo(&second_project, "run -j1")
+        .env("CACHE_TEST_VALUE", "one")
+        .with_stdout_data("one\n")
+        .run();
+    assert!(library.is_file());
+}
