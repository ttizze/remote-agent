+fn shared_outputs_are_current(fingerprint: &Fingerprint) -> bool {
+    let Ok(outputs) = fingerprint
+        .outputs
+        .iter()
+        .map(|path| paths::mtime(path))
+        .collect::<CargoResult<Vec<_>>>()
