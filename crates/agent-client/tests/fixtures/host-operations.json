[
  {
    "name": "list workspace files",
    "command": {
      "type": "listFiles",
      "path": "/workspace"
    },
    "exchanges": [
      {
        "method": "host/file/list",
        "params": {
          "path": "/workspace"
        },
        "response": {
          "result": {
            "path": "/workspace",
            "entries": [
              {
                "name": "notes.txt",
                "path": "/workspace/notes.txt",
                "directory": false,
                "size": 14
              }
            ],
            "truncated": false
          }
        }
      }
    ],
    "resultRef": "/exchanges/0/response/result"
  },
  {
    "name": "read preserves revision BOM and line endings",
    "command": {
      "type": "readFile",
      "path": "/workspace/notes.txt"
    },
    "exchanges": [
      {
        "method": "host/file/read",
        "params": {
          "path": "/workspace/notes.txt"
        },
        "response": {
          "result": {
            "path": "/workspace/notes.txt",
            "revision": "revision-1",
            "text": "日本語\r\n",
            "bom": true,
            "lineEnding": "crlf",
            "size": 14
          }
        }
      }
    ],
    "resultRef": "/exchanges/0/response/result"
  },
  {
    "name": "write passes optimistic revision and exact text",
    "command": {
      "type": "writeFile",
      "path": "/workspace/notes.txt",
      "revision": "revision-1",
      "text": "修正\r\n"
    },
    "exchanges": [
      {
        "method": "host/file/write",
        "params": {
          "path": "/workspace/notes.txt",
          "revision": "revision-1",
          "text": "修正\r\n"
        },
        "response": {
          "result": {
            "path": "/workspace/notes.txt",
            "revision": "revision-2",
            "text": "修正\r\n",
            "bom": true,
            "lineEnding": "crlf",
            "size": 11
          }
        }
      }
    ],
    "resultRef": "/exchanges/0/response/result"
  },
  {
    "name": "workspace review",
    "command": {
      "type": "reviewWorkspace",
      "cwd": "/workspace"
    },
    "exchanges": [
      {
        "method": "host/workspace/review",
        "params": {
          "cwd": "/workspace"
        },
        "response": {
          "result": {
            "branch": "fixture",
            "additions": 2,
            "deletions": 1,
            "files": [
              {
                "path": "notes.txt",
                "status": "modified",
                "additions": 2,
                "deletions": 1
              }
            ],
            "diff": "fixture diff"
          }
        }
      }
    ],
    "resultRef": "/exchanges/0/response/result"
  },
  {
    "name": "read worktree settings",
    "command": {
      "type": "worktreeSettings"
    },
    "exchanges": [
      {
        "method": "host/worktree/settings/read",
        "params": {},
        "response": {
          "result": {
            "createOnNewSession": true,
            "copyOnCreate": true,
            "copyPaths": [
              ".env.example",
              "assets"
            ],
            "worktreeDirectory": "/worktrees"
          }
        }
      }
    ],
    "resultRef": "/exchanges/0/response/result"
  },
  {
    "name": "write worktree settings",
    "command": {
      "type": "updateWorktreeSettings",
      "settings": {
        "createOnNewSession": true,
        "copyOnCreate": true,
        "copyPaths": [
          ".env.example",
          "assets"
        ],
        "worktreeDirectory": "/worktrees"
      }
    },
    "exchanges": [
      {
        "method": "host/worktree/settings/update",
        "params": {
          "createOnNewSession": true,
          "copyOnCreate": true,
          "copyPaths": [
            ".env.example",
            "assets"
          ],
          "worktreeDirectory": "/worktrees"
        },
        "response": {
          "result": {
            "createOnNewSession": true,
            "copyOnCreate": true,
            "copyPaths": [
              ".env.example",
              "assets"
            ],
            "worktreeDirectory": "/worktrees"
          }
        }
      }
    ],
    "resultRef": "/exchanges/0/response/result"
  },
  {
