                "chatgptAccountId": "synthetic-account"
              }
            ],
            "selectedId": "account-a",
            "error": null
          }
        }
      }
    ],
    "resultRef": "/exchanges/0/response/result"
  },
  {
    "name": "select reports persistence failure without losing selection",
    "command": {
      "type": "selectAccount",
      "accountId": "account-a"
    },
    "exchanges": [
      {
        "method": "host/account/select",
        "params": {
          "accountId": "account-a"
        },
        "response": {
          "result": {
            "selectedId": "account-a",
            "persistenceError": "fixture persistence failure"
          }
        }
      }
    ],
    "resultRef": "/exchanges/0/response/result"
  },
