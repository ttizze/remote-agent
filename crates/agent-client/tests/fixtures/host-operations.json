  {
    "name": "fork retains unknown Codex thread metadata",
    "command": {
      "type": "forkThread",
      "threadId": "thread",
      "lastTurnId": "last"
    },
    "exchanges": [
      {
        "method": "thread/fork",
        "params": {
          "threadId": "thread",
          "lastTurnId": "last",
          "excludeTurns": true
        },
        "response": {
          "result": {
            "thread": {
              "id": "fork",
              "turns": [],
              "future": {
                "retained": true
              }
            }
          }
        }
      }
    ],
    "resultRef": "/exchanges/0/response/result"
  },
  {
    "name": "file conflict retains Host error",
    "command": {
      "type": "writeFile",
      "path": "/workspace/notes.txt",
      "revision": "stale",
      "text": "x"
    },
    "exchanges": [
      {
        "method": "host/file/write",
        "params": {
          "path": "/workspace/notes.txt",
          "revision": "stale",
          "text": "x"
        },
        "response": {
          "error": {
            "code": "revision_conflict",
            "message": "revision changed"
          }
        }
      }
    ],
    "errorContains": "revision changed",
    "errorRawRef": "/exchanges/0/response/error"
  },
  {
    "name": "account switch blocked while active",
    "command": {
      "type": "selectAccount",
      "accountId": "account-a"
    },
    "exchanges": [
      {
        "method": "host/account/select",
        "params": {
          "accountId": "account-a"
        },
        "response": {
          "error": {
            "code": "busy",
            "message": "active turn"
          }
        }
      }
    ],
    "errorContains": "active turn",
    "errorRawRef": "/exchanges/0/response/error"
  }
]
