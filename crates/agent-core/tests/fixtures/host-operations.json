    "result": {
      "completed": true,
      "accountId": "account-a"
    }
  },
  {
    "name": "cancel account login",
    "command": {
      "type": "cancelAccountLogin",
      "loginId": "fixture-login"
    },
    "exchanges": [
      {
        "method": "host/account/login/cancel",
        "params": {
          "loginId": "fixture-login",
          "instanceId": "codex"
        },
        "response": {
          "result": {}
        }
      }
    ],
    "result": null
  },
  {
    "name": "fork retains unknown Codex thread metadata",
    "command": {
      "type": "forkThread",
      "threadId": {
        "id": "thread"
      },
      "lastTurnId": "last"
    },
    "exchanges": [
      {
        "method": "host/session/fork",
        "params": {
          "threadId": {
            "id": "thread"
          },
          "lastTurnId": "last"
        },
        "response": {
          "result": {
            "thread": {
              "id": {
                "id": "fork"
              },
              "turns": [],
              "future": {
                "retained": true
              },
              "provider": {
                "instanceId": "codex",
                "driver": "codex"
              }
            }
          }
        }
      }
    ],
    "result": {
      "thread": {
        "id": {
          "id": "fork"
        },
        "turns": [],
        "future": {
          "retained": true
        },
        "provider": {
          "instanceId": "codex",
          "driver": "codex"
        }
      }
    }
  },
  {
    "name": "file conflict retains Host error",
    "command": {
      "type": "writeFile",
      "path": "/workspace/notes.txt",
      "revision": "stale",
      "text": "x"
    },
    "exchanges": [
      {
        "method": "host/file/write",
        "params": {
          "path": "/workspace/notes.txt",
          "revision": "stale",
          "text": "x"
        },
        "response": {
          "error": {
            "code": "revision_conflict",
            "message": "revision changed"
          }
        }
      }
    ],
    "errorContains": "revision changed",
    "errorRaw": {
      "code": "revision_conflict",
      "message": "revision changed"
    }
  },
  {
    "name": "account switch blocked while active",
    "command": {
      "type": "selectAccount",
      "accountId": "account-a"
    },
    "exchanges": [
      {
        "method": "host/account/select",
        "params": {
          "accountId": "account-a",
          "instanceId": "codex"
        },
        "response": {
          "error": {
            "code": "busy",
            "message": "active turn"
          }
        }
      }
    ],
    "errorContains": "active turn",
    "errorRaw": {
      "code": "busy",
      "message": "active turn"
    }
  }
]
