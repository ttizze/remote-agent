[
  {
    "name": "list workspace files",
    "command": {
      "type": "listFiles",
      "path": "/workspace"
    },
    "exchanges": [
      {
        "method": "host/file/list",
        "params": {
          "path": "/workspace"
        },
        "response": {
          "result": {
            "path": "/workspace",
            "entries": [
              {
                "name": "notes.txt",
                "path": "/workspace/notes.txt",
                "directory": false,
                "size": 14
              }
            ],
            "truncated": false
          }
        }
      }
    ],
    "result": {
      "path": "/workspace",
      "entries": [
        {
          "name": "notes.txt",
          "path": "/workspace/notes.txt",
          "directory": false,
          "size": 14
        }
      ],
      "truncated": false
    }
  },
  {
    "name": "read preserves revision BOM and line endings",
    "command": {
      "type": "readFile",
      "path": "/workspace/notes.txt"
    },
    "exchanges": [
      {
        "method": "host/file/read",
        "params": {
          "path": "/workspace/notes.txt"
        },
        "response": {
          "result": {
            "path": "/workspace/notes.txt",
            "revision": "revision-1",
            "text": "日本語\r\n",
            "size": 14
          }
        }
      }
    ],
    "result": {
      "path": "/workspace/notes.txt",
      "revision": "revision-1",
      "text": "日本語\r\n",
      "size": 14
    }
  },
  {
    "name": "write passes optimistic revision and exact text",
    "command": {
      "type": "writeFile",
      "path": "/workspace/notes.txt",
      "revision": "revision-1",
      "text": "修正\r\n"
    },
    "exchanges": [
      {
        "method": "host/file/write",
        "params": {
          "path": "/workspace/notes.txt",
          "revision": "revision-1",
          "text": "修正\r\n"
        },
        "response": {
          "result": {
            "path": "/workspace/notes.txt",
            "revision": "revision-2",
            "text": "修正\r\n",
            "size": 11
          }
        }
      }
    ],
    "result": {
      "path": "/workspace/notes.txt",
      "revision": "revision-2",
      "text": "修正\r\n",
      "size": 11
    }
  },
  {
    "name": "workspace review",
    "command": {
      "type": "reviewWorkspace",
      "cwd": "/workspace"
    },
    "exchanges": [
      {
        "method": "host/workspace/review",
        "params": {
          "cwd": "/workspace"
        },
        "response": {
          "result": {
            "branch": "fixture",
            "additions": 2,
            "deletions": 1,
            "files": [
              {
                "path": "notes.txt",
                "status": "modified",
                "additions": 2,
                "deletions": 1
              }
            ],
            "diff": "fixture diff"
          }
        }
      }
    ],
    "result": {
      "branch": "fixture",
      "additions": 2,
      "deletions": 1,
      "files": [
        {
          "path": "notes.txt",
          "status": "modified",
          "additions": 2,
          "deletions": 1
        }
      ],
      "diff": "fixture diff"
    }
  },
  {
    "name": "read worktree settings",
    "command": {
      "type": "worktreeSettings"
    },
    "exchanges": [
      {
        "method": "host/worktree/settings/read",
        "params": {},
        "response": {
          "result": {
            "createOnNewSession": true,
            "copyOnCreate": true,
            "copyPaths": [
              ".env.example",
              "assets"
            ],
            "worktreeDirectory": "/worktrees",
            "deleteMerged": false
          }
        }
      }
    ],
    "result": {
      "createOnNewSession": true,
      "copyOnCreate": true,
      "copyPaths": [
        ".env.example",
        "assets"
      ],
      "worktreeDirectory": "/worktrees",
      "deleteMerged": false
    }
  },
  {
    "name": "write worktree settings",
    "command": {
      "type": "updateWorktreeSettings",
      "settings": {
        "createOnNewSession": true,
        "copyOnCreate": true,
        "copyPaths": [
          ".env.example",
          "assets"
        ],
        "worktreeDirectory": "/worktrees",
        "deleteMerged": true
      }
    },
    "exchanges": [
      {
        "method": "host/worktree/settings/update",
        "params": {
          "createOnNewSession": true,
          "copyOnCreate": true,
          "copyPaths": [
            ".env.example",
            "assets"
          ],
          "worktreeDirectory": "/worktrees",
          "deleteMerged": true
        },
        "response": {
          "result": {
            "createOnNewSession": true,
            "copyOnCreate": true,
            "copyPaths": [
              ".env.example",
              "assets"
            ],
            "worktreeDirectory": "/worktrees",
            "deleteMerged": true
          }
        }
      }
    ],
    "result": {
      "createOnNewSession": true,
      "copyOnCreate": true,
      "copyPaths": [
        ".env.example",
        "assets"
      ],
      "worktreeDirectory": "/worktrees",
      "deleteMerged": true
    }
  },
  {
    "name": "list saved accounts",
    "command": {
      "type": "accounts"
    },
    "exchanges": [
      {
        "method": "host/account/list",
        "params": {},
        "response": {
          "result": {
            "accounts": [
              {
                "id": "account-a",
                "email": "fixture@example.test",
                "planType": "plus",
                "instanceId": "codex"
              }
            ],
            "error": null,
            "selected": {
              "codex": "account-a"
            }
          }
        }
      }
    ],
    "result": {
      "accounts": [
        {
          "id": "account-a",
          "email": "fixture@example.test",
          "planType": "plus",
          "instanceId": "codex"
        }
      ],
      "error": null,
      "selected": {
        "codex": "account-a"
      }
    }
  },
  {
    "name": "select reports persistence failure without losing selection",
    "command": {
      "type": "selectAccount",
      "accountId": "account-a"
    },
    "exchanges": [
      {
        "method": "host/account/select",
        "params": {
          "accountId": "account-a",
          "instanceId": "codex"
        },
        "response": {
          "result": {
            "selectedId": "account-a",
            "persistenceError": "fixture persistence failure",
            "instanceId": "codex"
          }
        }
      }
    ],
    "result": {
      "selectedId": "account-a",
      "persistenceError": "fixture persistence failure",
      "instanceId": "codex"
    }
  },
  {
