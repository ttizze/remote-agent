            "verificationUrl": "https://example.test/device",
            "requiresCodeSubmission": false,
            "instanceId": "codex"
          }
        }
      }
    ],
    "result": {
      "loginId": "fixture-login",
      "userCode": "TEST-ONLY",
      "verificationUrl": "https://example.test/device",
      "requiresCodeSubmission": false,
      "instanceId": "codex"
    }
  },
  {
    "name": "pending account login",
    "command": {
      "type": "accountLoginStatus",
      "loginId": "fixture-login"
