      "completed": false
    }
  },
  {
    "name": "completed account login",
    "command": {
      "type": "accountLoginStatus",
      "loginId": "fixture-login"
    },
    "exchanges": [
      {
        "method": "host/account/login/status",
        "params": {
          "loginId": "fixture-login",
          "instanceId": "codex"
        },
        "response": {
          "result": {
            "completed": true,
            "accountId": "account-a"
          }
        }
      }
