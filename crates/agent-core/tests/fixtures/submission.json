[
  {
    "name": "last active turn is steered",
    "snapshot": {
      "turns": [
        {
          "id": "first",
          "status": "inProgress"
        },
        {
          "id": "last",
          "status": "inProgress"
        },
        {
          "id": "done",
          "status": "completed"
        }
      ]
    },
    "listed": null,
    "expected": {
      "action": "steer",
      "turnId": "last"
    }
  },
  {
    "name": "active catalogue without loaded turn queues",
    "snapshot": null,
    "listed": {
      "status": {
        "type": "active"
      }
    },
    "expected": {
      "action": "queue"
    }
  },
  {
    "name": "active snapshot without loaded turn queues",
    "snapshot": {
      "status": {
        "type": "active"
      },
      "turns": []
    },
    "listed": null,
    "expected": {
      "action": "queue"
    }
  },
  {
    "name": "unloaded snapshot resumes with its directory",
    "snapshot": {
      "cwd": "/snapshot",
      "status": {
        "type": "notLoaded"
      }
    },
    "listed": {
      "cwd": "/listed"
    },
    "expected": {
      "action": "start",
      "cwd": "/snapshot",
      "resume": true
    }
  },
  {
    "name": "loaded idle snapshot starts directly",
    "snapshot": {
      "cwd": "/snapshot",
      "status": {
        "type": "idle"
      }
    },
    "listed": {
      "cwd": "/listed"
    },
    "expected": {
      "action": "start",
      "cwd": "/snapshot",
      "resume": false
    }
  },
  {
    "name": "catalogue directory resumes an absent snapshot",
    "snapshot": null,
    "listed": {
      "cwd": "/listed"
    },
    "expected": {
      "action": "start",
      "cwd": "/listed",
      "resume": true
    }
  },
  {
    "name": "blank snapshot directory falls back to catalogue",
    "snapshot": {
      "cwd": " ",
      "turns": []
    },
    "listed": {
      "cwd": "/listed"
    },
    "expected": {
      "action": "start",
      "cwd": "/listed",
      "resume": false
    }
  },
  {
    "name": "blank active ID cannot be steered",
    "snapshot": {
      "cwd": "/snapshot",
      "turns": [
        {
          "id": " ",
          "status": "inProgress"
        }
      ]
    },
    "listed": null,
    "expected": {
      "action": "start",
      "cwd": "/snapshot",
      "resume": false
    }
  },
  {
    "name": "missing directory rejects start",
    "snapshot": null,
    "listed": null,
    "expected": {
      "action": "reject",
      "message": "タスクの作業ディレクトリが不明です。タスク一覧を更新してください"
    }
  }
]
