    "1回限りの招待です。QRを読み取るか、招待をコピーして相手の端末に貼り付けてください。": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回限りの招待です。QRを読み取るか、招待をコピーして相手の端末に貼り付けてください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This invitation can be used once. Scan the QR code or copy the invitation to the other device."
          }
        }
      }
    },
