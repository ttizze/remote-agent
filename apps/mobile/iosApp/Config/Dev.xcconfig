// Separate iPhone app and sandbox for the development Host.
BEX_DEV_BUNDLE_Bex = dev.remoteagent.mobile.ios.dev
BEX_DEV_BUNDLE_BexTaskActivity = dev.remoteagent.mobile.ios.dev.TaskActivity
BEX_DEV_BUNDLE_BexUITests = dev.remoteagent.mobile.ios.dev.uitests
PRODUCT_BUNDLE_IDENTIFIER = $(BEX_DEV_BUNDLE_$(TARGET_NAME))
BEX_DEV_PRODUCT_Bex = BEX Dev
BEX_DEV_PRODUCT_BexTaskActivity = BexTaskActivity
BEX_DEV_PRODUCT_BexUITests = BexUITests
PRODUCT_NAME = $(BEX_DEV_PRODUCT_$(TARGET_NAME))
CURRENT_PROJECT_VERSION = 72
BEX_TASK_URL_SCHEME = bex-dev
