// Separate iPhone app for the development Host. APNs environment follows signing.
AGENT_DEV_BUNDLE_Bex = dev.remoteagent.mobile.ios.dev
AGENT_DEV_BUNDLE_TaskActivityExtension = dev.remoteagent.mobile.ios.dev.TaskActivity
AGENT_DEV_BUNDLE_UITests = dev.remoteagent.mobile.ios.dev.uitests
PRODUCT_BUNDLE_IDENTIFIER = $(AGENT_DEV_BUNDLE_$(TARGET_NAME))
AGENT_DEV_PRODUCT_Bex = BEX Dev
AGENT_DEV_PRODUCT_TaskActivityExtension = TaskActivityExtension
AGENT_DEV_PRODUCT_UITests = UITests
PRODUCT_NAME = $(AGENT_DEV_PRODUCT_$(TARGET_NAME))
ASSETCATALOG_COMPILER_APPICON_NAME = AppIconDev
AGENT_TASK_URL_SCHEME = bex-dev
