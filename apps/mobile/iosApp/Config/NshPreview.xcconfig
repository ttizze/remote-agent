// Swift-hosted conversation preview, with its own existing app data and signing profiles.
AGENT_DEV_BUNDLE_Bex = com.bex.nsh-preview
AGENT_DEV_BUNDLE_TaskActivityExtension = com.bex.nsh-preview.TaskActivity
AGENT_DEV_BUNDLE_UITests = com.bex.nsh-preview.uitests
PRODUCT_BUNDLE_IDENTIFIER = $(AGENT_DEV_BUNDLE_$(TARGET_NAME))
AGENT_DEV_PRODUCT_Bex = Bex NSH
AGENT_DEV_PRODUCT_TaskActivityExtension = TaskActivityExtension
AGENT_DEV_PRODUCT_UITests = UITests
PRODUCT_NAME = $(AGENT_DEV_PRODUCT_$(TARGET_NAME))
ASSETCATALOG_COMPILER_APPICON_NAME = AppIconDev
AGENT_TASK_URL_SCHEME = bex-nsh-preview
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) BEX_NSH_CONVERSATION
AGENT_NSH_BRIDGING_HEADER_Bex = $(SRCROOT)/Bex/NshConversationBridge.h
SWIFT_OBJC_BRIDGING_HEADER = $(AGENT_NSH_BRIDGING_HEADER_$(TARGET_NAME))
