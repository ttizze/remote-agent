<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="4dp">
    <TextView android:id="@+id/usage_window_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="1" android:textColor="?android:attr/textColorPrimary" />
    <ProgressBar android:id="@+id/usage_window_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginVertical="3dp" />
    <TextView android:id="@+id/usage_window_reset" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:maxLines="1" android:textColor="?android:attr/textColorSecondary" />
</LinearLayout>
