# As the window narrows, T3 Code's layout steps in. Below 768 points the
# sidebar leaves the content's side and opens as a sheet over it, which closes
# on its own toggle, Escape, or a chosen conversation. The composer's controls
# shorten the model name between the fast icon and reasoning meter, then
# hide that group when it cannot fit. Permissions live in the model picker.
# Attaching, dictation and sending stay, and nothing is cut off.
fixture /long-conversation/composer-narrow
expect "検証プロジェクト" 30000
press 検証プロジェクト
press "Long conversation" 20000
expect "Review section 14, input 0." 20000
expect_absent 承認方法を変更
expect 会話を検索
# The sidebar becomes a sheet, closed until opened.
window 760 760
expect_absent 会話を検索
expect "Fixture Model"
press サイドバーを開く
expect 会話を検索
expect_inside 会話を検索
screenshot sheet
press サイドバーを閉じる
expect_absent 会話を検索
press サイドバーを開く
key escape
expect_absent 会話を検索
# The backdrop beside the sheet closes it too; it follows the sheet's own
# controls, the last of which refreshes the list.
press サイドバーを開く
press サイドバーを閉じる after 会話を更新
expect_absent 会話を検索
press サイドバーを開く
press "Long conversation"
expect_absent 会話を検索
expect "Review section 14, input 0."
# The interrupted fixture otherwise offers Resume instead of Send.
type "AI に依頼する" "幅を変えても保持する下書き"
# About 400 points: the model controls fit, the review is its icon.
window 400 760
expect_absent "カスタム・未設定"
expect_inside 送信
expect_inside ファイルを添付
expect_absent 承認方法を変更
expect_inside Fast：オフ
expect_inside "Fixture Model"
expect_inside 音声をCodexで文字起こし
expect_inside "AI に依頼する"
expect_inside "2件のファイル"
screenshot controls
press サイドバーを開く
expect_inside 会話を検索
press サイドバーを閉じる
expect_absent 会話を検索
# Narrower: the name shortens between the quick controls and the microphone.
window 320 760
expect_absent 承認方法を変更
expect_inside 送信
expect_inside ファイルを添付
expect_inside Fast：オフ
expect_inside "Fixture Model"
expect_inside 音声をCodexで文字起こし
expect_apart "Fixture Model" 音声をCodexで文字起こし
screenshot shortened
# Last, the controls hide.
window 230 760
expect_absent Fast：オフ
expect_absent "Fixture Model"
expect_inside 送信
expect_inside ファイルを添付
expect_inside 音声をCodexで文字起こし
screenshot hidden
# Wide again, everything comes back with its label, the sidebar beside.
window 1200 760
expect_absent 承認方法を変更
expect_inside Fast：オフ
expect "Fixture Model"
expect 会話を検索
screenshot wide
