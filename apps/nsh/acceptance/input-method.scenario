# Japanese typed through an input method sends as the user sees it. The
# driver hands the composer an input method's marked text and commits as
# AppKit's NSTextInputClient receives them; the system input source is never
# changed.
expect "何に取り組みますか？" 30000
# A return that confirms the conversion only commits it; the next one sends.
mark "AI に依頼する" k
mark "AI に依頼する" か
mark "AI に依頼する" かい
mark "AI に依頼する" かいわ
mark "AI に依頼する" 会話
key return
wait 1500
expect "何に取り組みますか？"
key return
expect_absent "何に取り組みますか？" 10000
expect "シミュレータで完了しました。" 30000
# The conversation has started: where it runs is no longer offered.
expect_absent "フォルダ:"
# The composer is empty again.
expect_absent 会話 after "AI に依頼する"
# Live conversion keeps the whole message marked: the send button sends it,
# after the text typed before it.
press 新しいチャット
expect "何に取り組みますか？" 10000
type "AI に依頼する" "前置き "
mark "AI に依頼する" お
mark "AI に依頼する" おく
mark "AI に依頼する" 送ります
press 送信
expect_absent "何に取り組みますか？" 10000
expect "シミュレータで完了しました。" 30000
expect "前置き 送ります" 10000
expect_absent "前置き" after "AI に依頼する"
screenshot sent
# A conversion committed by the input method itself sends with the button.
press 新しいチャット
expect "何に取り組みますか？" 10000
mark "AI に依頼する" に
mark "AI に依頼する" 二
commit "AI に依頼する" 二度目
press 送信
expect_absent "何に取り組みますか？" 10000
expect "シミュレータで完了しました。" 30000
expect "二度目" 10000
expect_absent "二度目" after "AI に依頼する"
