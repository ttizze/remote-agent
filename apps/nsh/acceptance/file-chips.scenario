# Paths in an answer show as file chips, an authored caption before its chip:
# a chip's menu copies its path, Command-click opens the file in the editor,
# and a press opens it in the tool panel.
expect "検証プロジェクト" 30000
press このプロジェクトで新しいチャット
type "AI に依頼する" "[file-paths] [immediate] ファイルを確認します"
press 送信
expect "確認したファイルです。" 30000
expect "hello.txt · L2"
expect "子ファイル"
expect "child.txt"
screenshot chips
# Command-click sends a chip's file to the editor, the fixture Host's fake one.
click cmd "*hello.txt · L2"
expect_file $AGENT_STATE_DIR/editor/opened contains "/project/hello.txt:2"
select "*確認したファイルです。*" "hello.txt · L2"
menu "*確認したファイルです。*"
press フルパスをコピー
expect_clipboard "/project/hello.txt:2"
press "*hello.txt · L2"
expect "日本語のファイル" after ツールを追加 20000
screenshot opened
