# The model picker opens from the composer, lists the provider's models and,
# keeps it open to adjust its reasoning level, which the composer shows.
# iOS: testSimulatorModelPickerUsesNativeFormAndAgentPicker, testSimulatorOpensAccountManagementFromSettingsAndModelPicker
expect "何に取り組みますか？" 30000
press モデル
expect "Fixture Model" 20000
expect "モデルを検索"
expect "Claude Code"
screenshot picker
press "Fixture Model" after モデルを検索
expect "モデルを検索"
expect "Fixture Model"
screenshot applied
key escape
# Escape closes it without choosing.
press "Fixture Model"
expect "モデルを検索"
key escape
expect_absent "モデルを検索"
# The picker's account row leads to the provider's accounts in the settings.
press "Fixture Model"
press アカウントと週間残量
expect "選択した環境のプロバイダー・アカウント・更新を管理します。" 10000
expect "desktop@example.invalid"
