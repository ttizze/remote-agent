# Standard TextView visibility through a multi-page archive with long Markdown/code.
fixture /render-conversation/render-scroll
expect "検証プロジェクト" 30000
# Keep the default viewport the visible paragraph markers assume.
window 1360 900
press 検証プロジェクト
press "Long conversation" 20000
expect "Latest interrupted conversation message is visible." 20000
scroll 会話の履歴 -20
# Paragraph 4 is newly exposed by 200 pt in the T3 conversation lane.
# A stale end-follow correction hides it again.
expect "*Render turn 58, paragraph 4.*" 5000
expect_scrolled この会話 0 0.98
